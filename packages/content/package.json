{
  "name": "@cstar/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/validate-content.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "story:doc": "node scripts/write-story-doc.mjs"
  },
  "dependencies": {
    "@cstar/game-core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cstar/config": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
