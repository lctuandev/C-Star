{
  "name": "cong-ty-c-star",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run build --filter=@cstar/web && pnpm --filter @cstar/e2e test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "2.11.7",
    "typescript": "~6.0.3"
  }
}
